# ================== ESP-IDF 标准忽略 ==================

# ---- 编译产物 ----
build/
*.bin
*.elf
*.map
*.hex
*.o
*.a
*.obj

# ---- 本机配置（想保留默认配置请建 sdkconfig.defaults 并入库）----
sdkconfig
sdkconfig.old

# ---- 组件依赖（可重新拉取）----
dependencies.lock
managed_components/

# ---- 编辑器与系统文件 ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- 日志与临时 ----
*.log
*.tmp
*~

# 本地工作流脚本（只在本机用，不入库）
b.sh
